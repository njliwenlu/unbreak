# Server-side only. Never prefix with VITE_ (that would expose it to the browser bundle).
GEMINI_API_KEY=

# Optional overrides
ARGON_MODEL=gemini-4-argon
# Frames per second sampled from the clip by the model.
ARGON_VIDEO_FPS=8
ARGON_FILE_TIMEOUT_MS=180000
ARGON_INFERENCE_TIMEOUT_MS=240000
PORT=8787
# Per-run archive of model requests, renders, responses and physics results. Empty = disabled.
RUN_ARCHIVE_DIR=runs
# Tests/rehearsal only: 1 = scripted MOCK critic (labeled in the UI; cannot reconstruct video).
# ARGON_MOCK=
# Test only (ignored unless ARGON_MOCK=1): injected critic failures and mock delay.
# ARGON_MOCK_CRITIC_FAULTS=timeout,ok
# ARGON_MOCK_CRITIC_MS=900
